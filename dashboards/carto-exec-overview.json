{
  "title": "Carto \u2014 Group Digital Executive Overview",
  "description": "Board-level view of the Carto digital trading journey: orders, order value, checkout health, the two failure modes that produce no alert (new range not published, orders stalled past the fulfilment seam), and the Joy assistant. Created by the carto-demo harness.",
  "layout_type": "ordered",
  "reflow_type": "auto",
  "template_variables": [
    {
      "name": "env",
      "prefix": "env",
      "available_values": [],
      "default": "prd"
    },
    {
      "name": "business_unit",
      "prefix": "business_unit",
      "available_values": [],
      "default": "*"
    },
    {
      "name": "fulfilment_method",
      "prefix": "fulfilment_method",
      "available_values": [],
      "default": "*"
    }
  ],
  "tags": [
    "team:carto-digital"
  ],
  "widgets": [
    {
      "definition": {
        "type": "note",
        "content": "# Carto Group \u2014 Digital Trade\nBoard-level view of the online journey: what customers are doing, what it is worth, and whether the things that break silently are breaking. Every tile below is filtered by the universal tag scheme (`env`, `business_unit`, `banner`, `channel`), not by host.",
        "background_color": "blue",
        "font_size": "16",
        "text_align": "left",
        "vertical_align": "top",
        "show_tick": false,
        "has_padding": true
      }
    },
    {
      "definition": {
        "title": "Trade \u2014 what the business is doing right now",
        "type": "group",
        "layout_type": "ordered",
        "background_color": "vivid_blue",
        "widgets": [
          {
            "definition": {
              "title": "Orders paid (1h)",
              "type": "query_value",
              "precision": 0,
              "autoscale": true,
              "requests": [
                {
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "a",
                      "query": "sum:carto.checkout.order{env:prd,result:paid}.as_count()",
                      "aggregator": "sum"
                    }
                  ],
                  "response_format": "scalar",
                  "formulas": [
                    {
                      "formula": "a"
                    }
                  ]
                }
              ]
            }
          },
          {
            "definition": {
              "title": "Order value (1h, AUD)",
              "type": "query_value",
              "precision": 0,
              "autoscale": true,
              "requests": [
                {
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "a",
                      "query": "sum:carto.bff.order.value{env:prd}",
                      "aggregator": "sum"
                    }
                  ],
                  "response_format": "scalar",
                  "formulas": [
                    {
                      "formula": "a"
                    }
                  ]
                }
              ]
            }
          },
          {
            "definition": {
              "title": "Checkout failures (1h)",
              "type": "query_value",
              "precision": 0,
              "autoscale": true,
              "requests": [
                {
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "a",
                      "query": "sum:carto.checkout.order{env:prd,!result:paid}.as_count()",
                      "aggregator": "sum"
                    }
                  ],
                  "response_format": "scalar",
                  "formulas": [
                    {
                      "formula": "a"
                    }
                  ]
                }
              ]
            }
          },
          {
            "definition": {
              "title": "Checkout success rate (%)",
              "type": "query_value",
              "precision": 2,
              "autoscale": true,
              "requests": [
                {
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "a",
                      "query": "100 * sum:carto.checkout.order{env:prd,result:paid}.as_count() / sum:carto.checkout.order{env:prd}.as_count()",
                      "aggregator": "avg"
                    }
                  ],
                  "response_format": "scalar",
                  "formulas": [
                    {
                      "formula": "a"
                    }
                  ]
                }
              ]
            }
          },
          {
            "definition": {
              "title": "Orders by fulfilment method",
              "type": "timeseries",
              "requests": [
                {
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "a",
                      "query": "sum:carto.checkout.order{env:prd,result:paid} by {fulfilment_method}.as_count()"
                    }
                  ],
                  "response_format": "timeseries",
                  "formulas": [
                    {
                      "formula": "a"
                    }
                  ],
                  "display_type": "bars"
                }
              ],
              "show_legend": true,
              "legend_layout": "auto",
              "legend_columns": [
                "avg",
                "max",
                "value"
              ]
            }
          },
          {
            "definition": {
              "title": "Order value by state (AUD)",
              "type": "timeseries",
              "requests": [
                {
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "a",
                      "query": "sum:carto.bff.order.value{env:prd} by {state}"
                    }
                  ],
                  "response_format": "timeseries",
                  "formulas": [
                    {
                      "formula": "a"
                    }
                  ],
                  "display_type": "bars"
                }
              ],
              "show_legend": true,
              "legend_layout": "auto",
              "legend_columns": [
                "avg",
                "max",
                "value"
              ]
            }
          }
        ]
      }
    },
