        "widgets": [
          {
            "definition": {
              "type": "note",
              "content": "**Content correctness.** `carto.catalogue.new_range.published_count` is how many of this week's published products the storefront is actually serving. It should equal 6. When it is 0 every request is still a 200 \u2014 nothing is down, so nothing else here moves.",
              "background_color": "yellow",
              "font_size": "14",
              "text_align": "left",
              "vertical_align": "top",
              "show_tick": false,
              "has_padding": true
            }
          },
          {
            "definition": {
              "title": "New-range products visible (should be 6)",
