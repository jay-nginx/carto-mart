              }
            ],
            "formulas": [
              {
                "formula": "query1"
              }
            ],
            "response_format": "timeseries",
            "style": {
              "palette": "dog_classic",
              "line_type": "solid",
              "line_width": "normal"
            },
            "display_type": "line"
          }
        ]
      }
    },
    {
      "definition": {
        "title": "Per-pillar evaluation latency (p95 ms)",
        "type": "timeseries",
        "show_legend": true,
        "legend_layout": "auto",
        "legend_columns": [
          "avg",
          "max",
          "value"
        ],
        "requests": [
          {
            "queries": [
              {
                "query": "p95:carto.guardrail.pillar_latency_ms{$env} by {pillar}",
                "data_source": "metrics",
                "name": "query1"
              }
            ],
            "formulas": [
              {
                "formula": "query1"
              }
            ],
            "response_format": "timeseries",
            "style": {
              "palette": "dog_classic",
              "line_type": "solid",
              "line_width": "normal"
            },
            "display_type": "line"
          }
        ]
      }
    },
    {
      "definition": {
        "title": "Human approvals: decided vs expired",
        "type": "timeseries",
        "show_legend": true,
        "legend_layout": "auto",
        "legend_columns": [
          "avg",
          "max",
          "value"
        ],
        "requests": [
          {
            "queries": [
              {
                "query": "sum:carto.guardrail.approval_decisions{$env} by {status}.as_count()",
                "data_source": "metrics",
                "name": "query1"
              },
              {
                "query": "sum:carto.guardrail.approvals_expired{$env}.as_count()",
                "data_source": "metrics",
                "name": "query2"
              }
            ],
            "formulas": [
              {
                "formula": "query1",
                "alias": "decided"
              },
              {
                "formula": "query2",
                "alias": "expired (denied)"
              }
            ],
            "response_format": "timeseries",
            "style": {
              "palette": "dog_classic",
              "line_type": "solid",
              "line_width": "normal"
            },
            "display_type": "bars"
          }
        ]
      }
    },
    {
      "definition": {
        "type": "note",
        "content": "### Reading a denial\\n\\nClick any denial through to the logs below. Each pillar writes the exact facts it observed \u2014 the scope it looked up, the order state it found, the spend it summed \u2014 so a refusal explains itself without anyone reading the evaluator's source.\\n\\nActions are joined to the order by `@order_id` and across the fulfilment seam by `@txn_id`, because a trace id stops at the edge of the instrumented estate.",
        "background_color": "gray",
        "font_size": "12",
        "text_align": "left",
        "vertical_align": "top",
        "show_tick": false,
        "tick_pos": "50%",
        "tick_edge": "left",
        "has_padding": true
      }
    },
    {
      "definition": {
        "title": "Denials, newest first",
        "type": "list_stream",
        "requests": [
          {
            "columns": [
              {
                "field": "timestamp",
                "width": "auto"
              },
              {
                "field": "service",
                "width": "auto"
              },
              {
                "field": "content",
                "width": "full"
              }
            ],
            "query": {
              "data_source": "logs_stream",
              "query_string": "service:carto-guardrails @guardrail_decision:deny",
              "indexes": [],
              "storage": "hot"
            },
            "response_format": "event_list"
          }
        ]
      }
    },
    {
      "definition": {
        "title": "Evidence gaps and bypasses \u2014 the two that are never benign",
        "type": "list_stream",
        "requests": [
          {
            "columns": [
              {
                "field": "timestamp",
                "width": "auto"
              },
              {
                "field": "service",
                "width": "auto"
              },
              {
                "field": "content",
                "width": "full"
              }
            ],
            "query": {
              "data_source": "logs_stream",
              "query_string": "service:carto-guardrails (@pillar:evidence @guardrail_decision:deny OR @guardrail_decision:bypassed)",
              "indexes": [],
              "storage": "hot"
            },
            "response_format": "event_list"
          }
        ]
      }
    }
  ]
}
