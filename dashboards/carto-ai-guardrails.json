          }
        ]
      }
    },
    {
      "definition": {
        "title": "Agent spend against the session budget (USD)",
        "type": "timeseries",
        "show_legend": true,
        "legend_layout": "auto",
        "legend_columns": [
          "avg",
          "max",
          "value"
        ],
        "requests": [
          {
            "queries": [
              {
                "query": "max:carto.guardrail.budget_used_usd{$env} by {agent_id}",
                "data_source": "metrics",
