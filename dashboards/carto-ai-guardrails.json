          }
        ]
      }
    },
    {
      "definition": {
        "title": "Action outcomes by type",
        "type": "timeseries",
        "show_legend": true,
        "legend_layout": "auto",
        "legend_columns": [
          "avg",
          "max",
          "value"
        ],
        "requests": [
          {
            "queries": [
              {
                "query": "sum:carto.guardrail.actions{$env} by {action,decision}.as_count()",
                "data_source": "metrics",
                "name": "query1"
              }
            ],
            "formulas": [
              {
                "formula": "query1"
              }
            ],
            "response_format": "timeseries",
            "style": {
              "palette": "dog_classic",
              "line_type": "solid",
              "line_width": "normal"
            },
