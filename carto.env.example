# ===========================================================================
#  Carto demo harness — single environment file
#
#  WHAT THIS IS
#  Every credential and environment choice the harness needs, in one place.
#  Copy it and fill in your own values:
#
#      cp carto.env.example carto.env
#
#  carto.env is gitignored. carto.env.example (this file) is tracked and must
#  never contain a real secret.
#
#  Nothing else in the repository hardcodes a key, an org, a project or a
#  region. If you have filled this file in, `./carto up` (Podman/Docker) and
#  `./carto k8s-deploy` (GKE) both work with no further edits.
#
#  WHICH SECTIONS DO I ACTUALLY NEED?
#    1 + 2 + 3   local run on Podman or Docker          (required)
#    4           deploying to GKE                       (only for GKE)
#    5 + 6       tagging and demo tuning                (sensible defaults)
# ===========================================================================


# ===========================================================================
#  1. DATADOG — required
# ===========================================================================
#  API key  Organization Settings -> API Keys          (sends data)
#  App key  Personal Settings -> Application Keys      (creates dashboards,
#           monitors, SLOs and synthetics via scripts/dd-push.py)
#
#  The app key needs these scopes: dashboards_write, monitors_write,
#  slos_write, synthetics_write, apm_read, logs_read_data.
DD_API_KEY=
DD_APP_KEY=

#  DD_SITE must match the Datadog site your org lives in. Getting this wrong
#  is the single most common setup failure: data is accepted but lands nowhere
#  you can see. Check the URL you log in to.
#
#    datadoghq.com        US1   app.datadoghq.com          (default)
#    us3.datadoghq.com    US3   us3.datadoghq.com
#    us5.datadoghq.com    US5   us5.datadoghq.com
#    datadoghq.eu         EU1   app.datadoghq.eu
#    ap1.datadoghq.com    AP1   ap1.datadoghq.com
#    ap2.datadoghq.com    AP2   ap2.datadoghq.com
#    ddog-gov.com         US1-FED
DD_SITE=datadoghq.com

#  Where the Raj Patel transaction-failure monitor sends mail. This is the one
#  alert routed to a person, so that a failure triggered live on stage reaches
#  an inbox in front of the room. Any Datadog notification target works:
#  an email address, @slack-channel, @teams-channel, @pagerduty-service.
ALERT_EMAIL=you@example.com

#  The storefront's base URL, as a person in front of the room would type it.
#  Datadog monitors, dashboards and catalog entities embed deep links back
#  into the app (the tracking page especially), and the host port differs by
#  deployment -- so it is set here once rather than hardcoded in each asset:
#
#    Compose          http://localhost:5175    (compose.yaml maps 5175 -> 80)
#    kind / local k8s http://localhost:8080    (ingress-nginx)
#    GKE              https://<your-domain>    (whatever the Ingress resolves to)
#
#  Change this and re-run `./carto assets` to re-point every deep link.
WEB_URL=http://localhost:5175


# ===========================================================================
#  2. ANTHROPIC — required for the Joy assistant and its Agent Observability
# ===========================================================================
#  Joy is the in-app shopping assistant. It is a real LLM call, traced through
#  Datadog Agent Observability (formerly LLM Observability), and it is the
#  subject of the AI Guardrails story in section 6.
#
#  Key from console.anthropic.com -> API Keys. Costs are small but non-zero:
#  the defaults below are deliberately frugal (Haiku, 180 output tokens, one
#  background call every 25s ~ 144 calls/hour). Set JOY_DRIVER_ENABLED=false
#  to stop background calls entirely; the in-app chat still works on demand.
ANTHROPIC_API_KEY=
JOY_MODEL=claude-haiku-4-5-20251001
JOY_INTERVAL_S=25
JOY_MAX_TOKENS=180
JOY_DRIVER_ENABLED=true
#  Fraction of Joy prompts seeded with a prompt-injection attempt, so the
#  injection monitor and AI Guard have something to catch. 0 disables it.
JOY_INJECTION_RATE=0.15


# ===========================================================================
#  3. RUM — optional, auto-provisioned
# ===========================================================================
#  `./carto rum` creates the RUM application in your org and writes the
#  applicationId and clientToken itself. Set these ONLY to reuse an existing
#  RUM application instead of having one created.
DD_RUM_APPLICATION_ID=
DD_RUM_CLIENT_TOKEN=


# ===========================================================================
#  4. CLOUD — only needed to deploy to GKE
# ===========================================================================
#  The harness ships Kubernetes manifests written for GKE. These values are
#  consumed by scripts/gke-deploy.sh and by the kustomize overlay.
#
#  Authenticate first, with ONE of:
#    gcloud auth login && gcloud auth application-default login     (a human)
#    export GOOGLE_APPLICATION_CREDENTIALS=/path/to/key.json        (a CI job)
GCP_PROJECT_ID=
GCP_REGION=australia-southeast1
GCP_ZONE=australia-southeast1-a

#  Cluster. gke-deploy.sh creates it if it does not exist.
GKE_CLUSTER_NAME=carto-demo
GKE_NODE_COUNT=3
GKE_MACHINE_TYPE=e2-standard-4
#  Autopilot is simpler and needs no node settings; Standard is cheaper to
#  run small and lets the Datadog Agent mount what it wants. The harness is
#  tested on Standard, because the Agent DaemonSet needs host access that
#  Autopilot restricts.
GKE_MODE=standard

#  Where built images are pushed. Artifact Registry is the GCP default:
#    REGION-docker.pkg.dev/PROJECT/REPOSITORY
#  Leave IMAGE_REGISTRY empty to run images built locally into kind instead.
IMAGE_REGISTRY=
IMAGE_TAG=latest

#  Kubernetes namespace for the whole stack.
K8S_NAMESPACE=carto

#  --- AWS (only if you point the demo at EKS or enable the AWS integration) --
AWS_REGION=
AWS_ACCOUNT_ID=
#  Prefer a role over static keys. Static keys are read only if the role is
#  absent, and they must never be committed.
AWS_ROLE_ARN=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

#  --- Azure (only if you point the demo at AKS or enable the Azure integration)
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=


# ===========================================================================
#  5. IDENTIFICATION — the tag taxonomy every signal carries
# ===========================================================================
#  Unified Service Tagging plus the business dimensions the demo argues for.
#  Change DD_ENV if you run more than one copy against the same org, or the
#  two stacks will blend together in every dashboard.
DD_ENV=prd
DD_HOSTNAME=harness-carto
HARNESS_OWNER=your-name
DD_OWNER=your-name
DD_TEAM=carto-digital
DD_ORG=carto
DD_PURPOSE=carto-demo
CARTO_BUSINESS_UNIT=carto-digital
CARTO_BANNER=carto


# ===========================================================================
#  6. AGENT AND DEMO TUNING — safe defaults, change if you know why
# ===========================================================================
DD_APM_ENABLED=true
DD_LOGS_ENABLED=true
DD_PROCESS_AGENT_ENABLED=true
DD_SYSTEM_PROBE_ENABLED=true
DD_DATA_STREAMS_ENABLED=true
DD_DATA_JOBS_MONITORING_ENABLED=false
DD_LOG_LEVEL=info

#  How many new-range products the storefront expects to be live. The content
#  correctness synthetic and its monitor compare against this number.
CARTO_EXPECTED_NEW_RANGE=6
#  Seconds between black-box fulfilment stage transitions.
CARTO_STAGE_INTERVAL_S=20
#  Browser journeys: 3 concurrent shoppers, 5-10s between each one's journeys.
LOAD_CONCURRENCY=3
LOOP_DELAY_MS=5000
#  Fraction of journeys that rage-click, for Error Tracking and frustration
#  signals in RUM.
RAGE_CLICK_PCT=0.35

#  --- AI Guardrails demo (see docs: the six pillars) ---------------------
#  The guardrail evaluator runs on every agent action. Turn pillars off to
#  show what their absence looks like, which is the point of the segment.
GUARDRAIL_ENABLED=true
#  Spend ceiling per agent session, in USD. Breaching it denies on Budget.
GUARDRAIL_BUDGET_USD=0.50
#  Order value above which a refund or price override needs a human.
GUARDRAIL_APPROVAL_THRESHOLD_AUD=150
#  Seconds a human approval request stays open before it is auto-denied.
GUARDRAIL_APPROVAL_TTL_S=120
