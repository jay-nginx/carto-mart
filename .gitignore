carto.env
# Any hand-made backup of carto.env carries the literal keys too. `carto.env.example`
# is deliberately NOT matched by this pattern and stays tracked.
carto.env.bak*
carto.env.local
synthetics-pl-config.json
rum-args.env
dd-artifacts.json
*.log

# Written by scripts/rum-provision.sh — holds YOUR org's RUM applicationId
# and client token. Each org needs its own, so this must not be shared.
docker-compose.override.yaml

# Sticky instrumentation mode written by `make up` (agent|dual|otel).
.mode

node_modules/
dist/
__pycache__/
.DS_Store
docker-compose.rum-dns.yaml

# Compose auto-loads .env if present. Used here only for Source Code
# Integration (DD_GIT_REPOSITORY_URL / DD_GIT_COMMIT_SHA), which point at
# whoever's fork this is, so they are not committed. Nothing generates this
# file — write it yourself if you want the feature, or set the two variables
# in carto.env instead.
.env

# Generated nginx snippet pinning the RUM intake IP (make rum-unblock).
web/rum-proxy/*.conf

# Stray artefacts from other tooling that happened to run in this directory —
# a codegraph index and its daemon log. Not part of the harness.
packages/
.codegraph/

# Scratch copies of the Kubernetes Secret, if you keep one on disk rather than
# creating it from carto.env. k8s/base/02-secret.yaml is the tracked PLACEHOLDER
# and stays tracked; anything named *.local.yaml is yours and must not be.
k8s/**/secret.local.yaml
k8s/**/*.local.yaml

# Engagement deliverables (the technical success-criteria workbook and the
# script that builds it). Customer material, not part of the harness, and it
# still carries the original brand -- it must never reach a public repo.
deliverables/
