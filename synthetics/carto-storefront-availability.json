{
  "name": "[Carto] Storefront availability",
  "type": "api",
  "subtype": "http",
  "message": "The Carto storefront is not serving. This is the ordinary availability check \u2014 the one that stays green through the content failure above, which is the point of having both.",
  "config": {
    "request": {
      "method": "GET",
      "url": "http://web/healthz",
      "timeout": 20
    },
    "assertions": [
      {
        "type": "statusCode",
        "operator": "is",
        "target": 200
      },
      {
        "type": "responseTime",
        "operator": "lessThan",
        "target": 2000
      },
      {
        "type": "body",
        "operator": "contains",
        "target": "ok"
      }
    ]
  },
  "locations": [],
  "options": {
    "tick_every": 60,
    "min_failure_duration": 0,
    "min_location_failed": 1,
    "retry": {
      "count": 1,
      "interval": 3000
    },
    "monitor_options": {
      "renotify_interval": 0
    },
    "monitor_priority": 2
  },
  "tags": [
    "harness:carto",
    "team:carto-digital",
    "purpose:carto-demo",
    "env:prd",
    "check:availability"
  ],
  "status": "live"
}